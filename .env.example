# ========================= VaultBot configuration =========================
# Copy this file to .env and fill in your values. NEVER commit .env.

# --- Required -------------------------------------------------------------
# Bot token from @BotFather
BOT_TOKEN=123456789:AAE...your-token...

# --- Optional: paths (defaults live under ./data) --------------------------
#DATA_DIR=./data
#DB_PATH=./data/vaultbot.db
#TMP_DIR=./data/tmp
#BACKUP_DIR=./data/backups

# --- Optional: AI (leave AI_PROVIDER=none to run without any AI) -----------
# "none" disables all AI features gracefully; the bot stays fully usable.
# "openai" enables summarization/tag suggestions via an OpenAI-compatible API.
# "mock" is a key-less fake provider for trying the UX.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Max file size (MB) that AI features may temporarily download to /tmp
# (always deleted right after processing).
AI_MAX_DOWNLOAD_MB=25

# --- Optional: behavior -----------------------------------------------------
ADMIN_IDS=
PAGE_SIZE=10
TMP_MAX_AGE_MINUTES=30
BACKUP_KEEP=3
BACKUP_INTERVAL_HOURS=24
LOG_LEVEL=INFO
# Optional rotating file log (5MB x 3). Empty = console only (recommended
# in Docker, where docker itself rotates container logs).
LOG_FILE=
